generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// ─── Catalog ───────────────────────────────────────────────────────────────

// NOTE ON STRING SIZES (Postgres -> MySQL):
// Postgres `String` was unlimited TEXT; MySQL defaults to VARCHAR(191), which
// would silently cap existing content (product shortDesc already reaches 176
// chars). Free-form text is therefore @db.Text and human-entered fields are
// widened. Indexed columns (@id/@unique) stay at the 191 default so they fit
// MySQL's utf8mb4 index-length limit.

model Category {
  slug      String    @id
  nameEn    String    @db.VarChar(255)
  nameHy    String    @db.VarChar(255)
  nameRu    String    @db.VarChar(255)
  skuPrefix String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id              String          @id
  nameEn          String          @db.VarChar(255)
  nameHy          String          @db.VarChar(255)
  nameRu          String          @db.VarChar(255)
  shortDescEn     String          @db.Text
  shortDescHy     String          @db.Text
  shortDescRu     String          @db.Text
  descriptionEn   String          @db.Text
  descriptionHy   String          @db.Text
  descriptionRu   String          @db.Text
  price           Int
  discountedPrice Int?
  // MySQL/MariaDB has no scalar list type, so these are JSON arrays of URLs.
  // Order is meaningful: images[0] is the product's main image.
  // Read via jsonToStringArray() (lib/json-array.ts); write a plain string[].
  // No @default: MariaDB can't default a JSON/LONGTEXT column, and every
  // create path sets them explicitly.
  images          Json
  videos          Json
  category        String
  categoryRef     Category        @relation(fields: [category], references: [slug], onUpdate: Cascade)
  size            String
  weightGrams     Int?
  lengthCm        Int?
  widthCm         Int?
  heightCm        Int?
  sku             String          @unique
  stockQuantity   Int             @default(10)
  includedItems   Json?
  featured        Boolean         @default(false)
  bestseller      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  orderItems      OrderItem[]
}

// ─── Contact form submissions ──────────────────────────────────────────────

model ContactApplication {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  phone     String
  message   String?  @db.Text
  createdAt DateTime @default(now())
}

// ─── Orders ────────────────────────────────────────────────────────────────

model Order {
  id             String         @id @default(cuid())
  customerName   String         @db.VarChar(255)
  customerPhone  String
  customerEmail  String?
  address        String?        @db.VarChar(500)
  city           String?
  shippingMethod String         @default("")
  cityCode       Int?
  pickupPointCode String?
  pickupPointName String?       @db.VarChar(500)
  pickupPointAddress String?    @db.VarChar(500)
  tariffCode     Int?
  cdekPrice      Int?
  finalPrice     Int?
  shippingCost   Int            @default(0)
  subtotal       Int            @default(0)
  total          Int
  status         OrderStatus    @default(PENDING)
  yookassaId     String?        @unique
  yookassaStatus String?
  cdekUuid       String?
  cdekTrackingNumber String?
  cdekRawResponse Json?
  cdekStatus     String?
  createdAt      DateTime       @default(now())
  items          OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  price     Int
}

// ─── Admin ─────────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
