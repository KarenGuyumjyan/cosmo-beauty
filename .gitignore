# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Postgres -> MySQL data migration dump (contains customer PII: names, phones,
# emails, addresses). Never commit.
/prisma/data-export.json

# Backups of .env taken during the Postgres -> MySQL migration (contain
# production database credentials). Never commit.
.env.backup-*

# This project uses npm (package-lock.json). A stray yarn.lock makes Next.js
# shell out to `yarn`, which breaks builds on servers without yarn installed.
yarn.lock
